<Application x:Class="Nightwell.Native.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Pumpkin" Color="#FFB260"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#FFF5FF"/><Setter Property="Background" Value="#33281B38"/><Setter Property="BorderBrush" Value="#44E7C6FF"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="4"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="20"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFF5FF"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#8820142C"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="17"/></Style>
 </Application.Resources>
</Application>
