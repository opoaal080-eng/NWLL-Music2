<Window x:Class="Nightwell.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nightwell.Native" Title="Nightwell Music" Width="1100" Height="820" MinWidth="620" MinHeight="540" Background="#100A1B">
 <Grid>
  <Grid.Background><ImageBrush ImageSource="season.jpg" Stretch="UniformToFill"/></Grid.Background>
  <Rectangle Fill="#5510071B" IsHitTestVisible="False"/>
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel x:Name="Header" Margin="0,0,0,16"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Image Source="logo.png" Width="46" Margin="0,0,12,0"/><StackPanel><TextBlock Text="Nightwell" FontSize="30" FontWeight="Bold"/><TextBlock Text="M U S I C" Foreground="#B9A4CF" FontSize="12"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Поиск" Click="SearchClick"/><Button Content="☰" Click="MenuClick"/></StackPanel></DockPanel>
   <Grid Grid.Row="1">
    <Grid x:Name="Home"><local:RibbonScene x:Name="Ribbon"/><StackPanel VerticalAlignment="Top" Margin="10,24"><TextBlock Text="H A L L O W E E N   E D I T I O N" Foreground="#FFBA7A" FontSize="12"/><TextBlock Text="Твой&#10;тёмный ритм" FontSize="58" FontWeight="Bold" Margin="0,22"/></StackPanel><Button x:Name="HomePlay" Content="▶" FontSize="44" Width="120" Height="100" BorderBrush="Transparent" Background="Transparent" Click="ToggleClick"/><StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,64"><Button Content="Новая подборка" Click="WaveClick"/><Button Content="Только фон" Click="BackgroundClick"/></StackPanel></Grid>
    <Grid x:Name="Library" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock x:Name="Heading" Text="Поиск" FontSize="32" FontWeight="Bold"/><Button x:Name="CollectionActions" Content="⋯" HorizontalAlignment="Right" Click="CollectionClick"/></DockPanel><TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,14" TextChanged="SearchChanged"/>
     <ListBox x:Name="Tracks" Grid.Row="2" Background="#66150E20" BorderThickness="0" Foreground="White" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="TrackDoubleClick" HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="10,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding artist}" Foreground="#BAAEC8" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="⋯" Tag="{Binding}" Click="TrackMenuClick"/></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    <Grid x:Name="PlayerPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button Content="⌄" Click="ClosePlayerClick"/><TextBlock Text="Играет сейчас" FontSize="24" HorizontalAlignment="Center"/><Button Content="⋯" HorizontalAlignment="Right" Click="CurrentMenuClick"/></DockPanel><Grid Grid.Row="1"><Image x:Name="Cover" Stretch="Uniform" Margin="20"/><ScrollViewer x:Name="LyricsPanel" Visibility="Collapsed"><TextBlock x:Name="LyricsText" TextWrapping="Wrap" FontSize="25" Margin="28" LineHeight="42"/></ScrollViewer></Grid><StackPanel Grid.Row="2"><TextBlock x:Name="FullTitle" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="FullArtist" FontSize="18" Foreground="#BAAEC8"/><Slider x:Name="FullSeek" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="SeekStart" PreviewMouseLeftButtonUp="SeekEnd" Margin="0,20,0,0"/><TextBlock x:Name="FullTime"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Перемешать" Click="ShuffleClick"/><Button Content="|◁" Click="PreviousClick"/><Button x:Name="FullPlay" Content="▶" Click="ToggleClick"/><Button Content="▷|" Click="NextClick"/><Button Content="Повтор" Click="RepeatClick"/></StackPanel><Button Content="Дальше в очереди" Click="QueueClick"/></StackPanel></Grid>
   </Grid>
   <TextBlock x:Name="Status" Grid.Row="2" Foreground="#FFCE9A" Margin="5,10" TextWrapping="Wrap"/>
   <Border x:Name="Dock" Grid.Row="3" Background="#4420142B" BorderBrush="#22E4C7FF" BorderThickness="1" CornerRadius="28" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="MiniProgress" Background="#27AD896B" HorizontalAlignment="Left" Width="0" Grid.ColumnSpan="2" IsHitTestVisible="False" CornerRadius="16"/><Grid MouseLeftButtonUp="OpenPlayerClick" Cursor="Hand" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="MiniCover" Width="52" Height="52" Stretch="UniformToFill" Margin="0,0,12,0"><Image.Clip><RectangleGeometry Rect="0,0,52,52" RadiusX="12" RadiusY="12"/></Image.Clip></Image><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="MiniTitle" Text="Выбери трек" FontSize="19" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MiniArtist" Text="Nightwell Music" Foreground="#BAAEC8" Margin="0,4,0,0"/></StackPanel></Grid><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="MiniLike" Content="♡" Foreground="#FFB260" Background="Transparent" BorderBrush="Transparent" FontSize="24" Padding="6" Click="LikeClick"/><Button Content="|◁" Click="PreviousClick"/><Button x:Name="MiniPlay" Content="▶" Width="48" Height="48" Background="Transparent" BorderBrush="#FFB260" Padding="0" Click="ToggleClick"/><Button Content="▷|" Click="NextClick"/></StackPanel></Grid></Border>
  </Grid>
 </Grid>
</Window>
