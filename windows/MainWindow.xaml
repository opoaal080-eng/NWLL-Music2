<Window x:Class="Nightwell.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nightwell.Native"
 Title="Nightwell Music" Width="1080" Height="800" MinWidth="700" MinHeight="570"
 WindowStartupLocation="CenterScreen" Background="#07090D" FontFamily="Segoe UI" Foreground="White">
 <Grid>
  <Grid.Background>
   <LinearGradientBrush StartPoint="0,0" EndPoint="0.95,1">
    <GradientStop Color="#171C25" Offset="0"/><GradientStop Color="#090B0F" Offset="0.48"/><GradientStop Color="#040609" Offset="1"/>
   </LinearGradientBrush>
  </Grid.Background>
  <Ellipse Width="650" Height="650" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-330,-280,0" IsHitTestVisible="False">
   <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#183B4452" Offset="0"/><GradientStop Color="#00272B31" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
  </Ellipse>
  <Grid Margin="28,23,28,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel x:Name="Header" Margin="0,0,0,17" LastChildFill="False">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#4EFFFFFF" CornerRadius="14" Width="48" Height="48" BorderBrush="#68FFFFFF" BorderThickness="1" Margin="0,0,14,0">
      <TextBlock Text="NW" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="Nightwell" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="M U S I C" FontSize="10" Foreground="#A6ACB7" Margin="2,-1,0,0"/></StackPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="⌕   Поиск" Click="SearchClick" MinWidth="105" Height="42"/>
     <Button Content="☰" Click="MenuClick" Width="49" Height="42" FontSize="22"/>
    </StackPanel>
   </DockPanel>
   <Border Grid.Row="1" CornerRadius="27" BorderThickness="1" BorderBrush="#34FFFFFF" Background="#16181F26" ClipToBounds="True">
    <Grid Margin="5">
     <Grid x:Name="Home">
      <local:RibbonScene x:Name="Ribbon" IsHitTestVisible="False"/>
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,28,0,0">
       <TextBlock Text="Твой ритм" FontSize="52" FontWeight="Bold"/>
       <TextBlock Text="Музыка под твоё настроение" Foreground="#B3BDC6" FontSize="17" Margin="2,6,0,0"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,25,0,0">
       <Button x:Name="HomePlay" Content="▶" FontSize="33" Width="95" Height="95" Background="#5A505763" BorderBrush="#99FFFFFF" Click="ToggleClick"/>
       <Button Content="Новая подборка" Width="186" Height="46" Margin="0,20,0,0" Click="WaveClick"/>
       <Button Content="Только фон" FontSize="12" Background="#1BFFFFFF" Width="150" Margin="0,10,0,0" Click="BackgroundClick"/>
      </StackPanel>
     </Grid>
     <Grid x:Name="Library" Visibility="Collapsed" Margin="22,20,22,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="False"><TextBlock x:Name="Heading" Text="Поиск" FontSize="29" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CollectionActions" Content="⋯" FontSize="22" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="CollectionClick"/></DockPanel>
      <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,14,0,14" TextChanged="SearchChanged" Height="48"/>
      <ListBox x:Name="Tracks" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="TrackDoubleClick" HorizontalContentAlignment="Stretch">
       <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#16FFFFFF" BorderThickness="0,0,0,1" Padding="5,7"><Grid Margin="6,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding artist}" Foreground="#AEB5C0" Margin="0,5,0,0" FontSize="13"/></StackPanel>
        <Button Grid.Column="1" Content="⋯" Tag="{Binding}" Click="TrackMenuClick" FontSize="19" Background="#15FFFFFF"/>
       </Grid></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <Grid x:Name="PlayerPage" Visibility="Collapsed" Margin="20,12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="False"><Button Content="⌄" Click="ClosePlayerClick" Width="45"/><TextBlock Text="Сейчас играет" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25,0"/><Button Content="⋯" DockPanel.Dock="Right" FontSize="20" Click="CurrentMenuClick"/></DockPanel>
      <Grid Grid.Row="1" Margin="0,5"><Image x:Name="Cover" Stretch="Uniform" Margin="24"/><ScrollViewer x:Name="LyricsPanel" Visibility="Collapsed" Background="#990B0E13"><TextBlock x:Name="LyricsText" TextWrapping="Wrap" FontSize="23" Margin="28" LineHeight="40"/></ScrollViewer></Grid>
      <StackPanel Grid.Row="2" Width="440" HorizontalAlignment="Center">
       <TextBlock x:Name="FullTitle" TextAlignment="Center" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="FullArtist" TextAlignment="Center" FontSize="15" Foreground="#B7BEC8" Margin="0,5,0,4"/>
       <Slider x:Name="FullSeek" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="SeekStart" PreviewMouseLeftButtonUp="SeekEnd" Margin="0,10,0,0"/>
       <TextBlock x:Name="FullTime" FontSize="12" Foreground="#B7BEC8" HorizontalAlignment="Center" Margin="0,3,0,2"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Content="⇄" FontSize="20" Click="ShuffleClick"/><Button Content="|◁" FontSize="20" Click="PreviousClick"/>
        <Button x:Name="FullPlay" Content="▶" FontSize="26" Width="72" Height="64" Background="#5A555E6A" Click="ToggleClick"/>
        <Button Content="▷|" FontSize="20" Click="NextClick"/><Button Content="↻" FontSize="20" Click="RepeatClick"/>
       </StackPanel>
       <Button Content="Очередь воспроизведения" Click="QueueClick" Background="#1BFFFFFF" FontSize="12" Margin="0,4,0,0"/>
      </StackPanel>
     </Grid>
    </Grid>
   </Border>
   <TextBlock x:Name="Status" Grid.Row="2" Foreground="#D8DAE1" Margin="12,10,12,7" FontSize="12" TextWrapping="Wrap" MaxHeight="43"/>
   <Border x:Name="Dock" Grid.Row="3" Background="#624E5561" BorderBrush="#6DFFFFFF" BorderThickness="1" CornerRadius="25" Padding="11" Height="81">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border x:Name="MiniProgress" Background="#4CBCC8D3" HorizontalAlignment="Left" Width="0" Grid.ColumnSpan="2" IsHitTestVisible="False" CornerRadius="18"/>
     <Grid MouseLeftButtonUp="OpenPlayerClick" Cursor="Hand" VerticalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image x:Name="MiniCover" Width="53" Height="53" Stretch="UniformToFill" Margin="0,0,12,0"><Image.Clip><RectangleGeometry Rect="0,0,53,53" RadiusX="12" RadiusY="12"/></Image.Clip></Image>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock x:Name="MiniTitle" Text="Выбери трек" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="MiniArtist" Text="Nightwell Music" Foreground="#BFC4CD" FontSize="12" Margin="0,5,0,0"/>
      </StackPanel>
     </Grid>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="MiniLike" Content="♡" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="23" Padding="6" Click="LikeClick"/>
      <Button Content="|◁" Click="PreviousClick" FontSize="18"/>
      <Button x:Name="MiniPlay" Content="▶" Width="51" Height="51" Background="#4CFFFFFF" BorderBrush="#8BFFFFFF" Padding="0" FontSize="19" Click="ToggleClick"/>
      <Button Content="▷|" Click="NextClick" FontSize="18"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
