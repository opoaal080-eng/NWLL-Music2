<Window x:Class="Nightwell.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nightwell.Native"
 Title="Nightwell Music" Width="1080" Height="815" MinWidth="790" MinHeight="630"
 WindowStartupLocation="CenterScreen" Background="#07090D" FontFamily="Segoe UI" Foreground="White">
 <Grid>
  <Grid.Background>
   <LinearGradientBrush StartPoint="0,0" EndPoint="0.95,1">
    <GradientStop Color="#171C25" Offset="0"/><GradientStop Color="#090B0F" Offset="0.48"/><GradientStop Color="#040609" Offset="1"/>
   </LinearGradientBrush>
  </Grid.Background>
  <Ellipse Width="650" Height="650" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-330,-280,0" IsHitTestVisible="False">
   <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#183B4452" Offset="0"/><GradientStop Color="#00272B31" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
  </Ellipse>
  <Grid Margin="28,23,28,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel x:Name="Header" Margin="0,0,0,17" LastChildFill="False">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#4EFFFFFF" CornerRadius="14" Width="48" Height="48" BorderBrush="#68FFFFFF" BorderThickness="1" Margin="0,0,14,0">
      <TextBlock Text="NW" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="Nightwell" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="M U S I C" FontSize="10" Foreground="#A6ACB7" Margin="2,-1,0,0"/></StackPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="⌕   Поиск" Click="SearchClick" MinWidth="105" Height="42"/>
     <Button Content="☰" Click="MenuClick" Width="49" Height="42" FontSize="22"/>
    </StackPanel>
   </DockPanel>
   <Border Grid.Row="1" CornerRadius="27" BorderThickness="1" BorderBrush="#34FFFFFF" Background="#16181F26" ClipToBounds="True">
    <Grid Margin="5">
     <Grid x:Name="Home">
      <local:RibbonScene x:Name="Ribbon" IsHitTestVisible="False"/>
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,28,0,0">
       <TextBlock Text="Твой ритм" FontSize="44" FontWeight="SemiBold"/>
       <TextBlock Text="Музыка под твоё настроение" Foreground="#B3BDC6" FontSize="15" Margin="2,6,0,0"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,25,0,0">
       <Button x:Name="HomePlay" Content="▶" FontSize="33" Width="95" Height="95" Background="#5A505763" BorderBrush="#99FFFFFF" Click="ToggleClick"/>
       <Button Content="Новая подборка" Width="186" Height="46" Margin="0,20,0,0" Click="WaveClick"/>
       <Button Content="Только фон" FontSize="12" Background="#1BFFFFFF" Width="150" Margin="0,10,0,0" Click="BackgroundClick"/>
      </StackPanel>
     </Grid>
     <Grid x:Name="Library" Visibility="Collapsed" Margin="22,20,22,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="False"><TextBlock x:Name="Heading" Text="Поиск" FontSize="29" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CollectionActions" Content="⋯" FontSize="22" HorizontalAlignment="Right" DockPanel.Dock="Right" Click="CollectionClick"/></DockPanel>
      <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,14,0,14" TextChanged="SearchChanged" Height="48"/>
      <ListBox x:Name="Tracks" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="TrackDoubleClick" HorizontalContentAlignment="Stretch">
       <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#16FFFFFF" BorderThickness="0,0,0,1" Padding="5,7"><Grid Margin="6,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding artist}" Foreground="#AEB5C0" Margin="0,5,0,0" FontSize="13"/></StackPanel>
        <Button Grid.Column="1" Content="⋯" Tag="{Binding}" Click="TrackMenuClick" FontSize="19" Background="#15FFFFFF"/>
       </Grid></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <Grid x:Name="PlayerPage" Visibility="Collapsed" ClipToBounds="True">
      <Grid.Background>
       <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#171B24" Offset="0"/><GradientStop Color="#090B10" Offset="0.6"/><GradientStop Color="#05070B" Offset="1"/>
       </LinearGradientBrush>
      </Grid.Background>
      <!-- iOS-style backdrop: a 6x6 colour grid sampled from album art, enlarged and blurred.
           Two layers crossfade when the track changes. -->
      <Grid ClipToBounds="True" IsHitTestVisible="False">
       <Image x:Name="AmbientArtworkA" Stretch="Fill" Opacity="0"
              RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.RenderTransform><ScaleTransform ScaleX="1.18" ScaleY="1.18"/></Image.RenderTransform>
        <Image.Effect><BlurEffect Radius="62" RenderingBias="Performance"/></Image.Effect>
       </Image>
       <Image x:Name="AmbientArtworkB" Stretch="Fill" Opacity="0"
              RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.RenderTransform><ScaleTransform ScaleX="1.18" ScaleY="1.18"/></Image.RenderTransform>
        <Image.Effect><BlurEffect Radius="62" RenderingBias="Performance"/></Image.Effect>
       </Image>
       <Border Background="#5005070C"/>
       <Border>
        <Border.Background>
         <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#51090B0F" Offset="0"/><GradientStop Color="#11090B0F" Offset="0.4"/><GradientStop Color="#78080A0F" Offset="1"/>
         </LinearGradientBrush>
        </Border.Background>
       </Border>
      </Grid>
      <Grid Margin="20,12,20,16">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="88"/><RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <DockPanel LastChildFill="False" Margin="4,0,4,7">
        <Button Content="⌄" Click="ClosePlayerClick" Width="45"/>
        <TextBlock Text="Сейчас играет" FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="17,0"/>
        <Button Content="⋯" DockPanel.Dock="Right" FontSize="20" Click="CurrentMenuClick"/>
       </DockPanel>
       <Grid Grid.Row="1" Margin="0,0,0,12">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                 MaxWidth="380" MaxHeight="360" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Border Width="344" Height="344" CornerRadius="27" Background="#252B33"
                 BorderBrush="#45FFFFFF" BorderThickness="1" ClipToBounds="True">
          <Image x:Name="Cover" Stretch="UniformToFill" Width="342" Height="342"/>
         </Border>
        </Viewbox>
        <ScrollViewer x:Name="LyricsPanel" Visibility="Collapsed" Width="440" HorizontalAlignment="Center"
                      Background="#DB0C1119" VerticalScrollBarVisibility="Auto">
         <TextBlock x:Name="LyricsText" TextWrapping="Wrap" FontSize="20" Margin="24"
                    LineHeight="32" TextAlignment="Center"/>
        </ScrollViewer>
       </Grid>
       <Border Grid.Row="2" MaxWidth="545" HorizontalAlignment="Center"
               Background="#61111820" BorderBrush="#32FFFFFF" BorderThickness="1"
               CornerRadius="25" Padding="18,14,18,12">
        <StackPanel Width="455" HorizontalAlignment="Center">
         <TextBlock x:Name="FullTitle" TextAlignment="Center" FontSize="22" FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"/>
         <TextBlock x:Name="FullArtist" TextAlignment="Center" FontSize="15" Foreground="#CDD1D9"
                    Margin="0,5,0,4"/>
         <Slider x:Name="FullSeek" Minimum="0" Maximum="1"
                 PreviewMouseLeftButtonDown="SeekStart" PreviewMouseLeftButtonUp="SeekEnd"
                 Margin="0,10,0,0"/>
         <TextBlock x:Name="FullTime" FontSize="12" Foreground="#CCD0D8" HorizontalAlignment="Center" Margin="0,3,0,4"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="⇄" FontSize="20" Click="ShuffleClick"/>
          <Button Content="|◁" FontSize="20" Click="PreviousClick"/>
          <Button x:Name="FullPlay" Content="▶" FontSize="26" Width="72" Height="64"
                  Background="#5A555E6A" Click="ToggleClick"/>
          <Button Content="▷|" FontSize="20" Click="NextClick"/>
          <Button Content="↻" FontSize="20" Click="RepeatClick"/>
         </StackPanel>
         <Button Content="Очередь воспроизведения" Click="QueueClick" Background="#1BFFFFFF"
                 FontSize="12" Margin="0,6,0,0"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9,0,0">
          <TextBlock Text="♪" Foreground="#DFE1E6" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Slider x:Name="FullVolumeSlider" Width="180" Minimum="0" Maximum="100" Value="100"
                  ValueChanged="VolumeChanged" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"/>
          <TextBlock x:Name="FullVolumeValue" Text="100%" Width="40" Foreground="#D5D6DD" FontSize="12"
                     TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
         </StackPanel>
        </StackPanel>
       </Border>
      </Grid>
     </Grid>
    </Grid>
   </Border>
   <TextBlock x:Name="Status" Grid.Row="2" Foreground="#D8DAE1" Margin="12,10,12,7" FontSize="12" TextWrapping="Wrap" MaxHeight="43"/>
   <Border x:Name="Dock" Grid.Row="3" Background="#50303945" BorderBrush="#56FFFFFF" BorderThickness="1" CornerRadius="22" Padding="11" Height="82">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border x:Name="MiniProgress" Background="#C0DCEAF9" HorizontalAlignment="Left" Width="0" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-7" Grid.ColumnSpan="2" IsHitTestVisible="False" CornerRadius="2"/>
     <Grid MouseLeftButtonUp="OpenPlayerClick" Cursor="Hand" VerticalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image x:Name="MiniCover" Width="53" Height="53" Stretch="UniformToFill" Margin="0,0,12,0"><Image.Clip><RectangleGeometry Rect="0,0,53,53" RadiusX="12" RadiusY="12"/></Image.Clip></Image>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock x:Name="MiniTitle" Text="Выбери трек" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="MiniArtist" Text="Nightwell Music" Foreground="#BFC4CD" FontSize="12" Margin="0,5,0,0"/>
      </StackPanel>
     </Grid>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="MiniLike" Content="♡" Foreground="White" Background="Transparent" BorderBrush="Transparent" FontSize="23" Padding="6" Click="LikeClick"/>
      <Button Content="|◁" Click="PreviousClick" FontSize="18"/>
      <Button x:Name="MiniPlay" Content="▶" Width="51" Height="51" Background="#4CFFFFFF" BorderBrush="#8BFFFFFF" Padding="0" FontSize="19" Click="ToggleClick"/>
      <Button Content="▷|" Click="NextClick" FontSize="18"/>
      <Border Width="1" Height="28" Background="#39FFFFFF" Margin="12,0"/>
      <TextBlock Text="♪" FontSize="17" Foreground="#C8D2DC" VerticalAlignment="Center" Margin="0,0,7,0"/>
      <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" Width="112"
              VerticalAlignment="Center" ValueChanged="VolumeChanged"
              AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0"/>
      <TextBlock x:Name="MiniVolumeValue" Text="100%" FontSize="11" Foreground="#AFC0D0" Width="34"
                 VerticalAlignment="Center" TextAlignment="Right" Margin="7,0,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
