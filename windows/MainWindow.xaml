<Window x:Class="Nightwell.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nightwell.Native"
 Title="Nightwell Music" Width="1120" Height="800" MinWidth="800" MinHeight="620" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}" PreviewKeyDown="InterfaceKeyDown">
 <Window.Resources><local:TrackMatchConverter x:Key="TrackMatch"/><local:CurrentArtworkConverter x:Key="CurrentCover"/><local:TrackCountConverter x:Key="TrackCount"/></Window.Resources>
 <Grid x:Name="WorkspaceRoot" Background="{StaticResource WindowBrush}" Margin="18,14,18,16">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Header" Grid.ColumnSpan="2" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="LogoHome" Click="LogoHomeClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="4,0" Margin="-4,0,0,0" ToolTip="На главную" AutomationProperties.Name="Nightwell Music, на главную">
    <StackPanel Orientation="Horizontal">
     <Border Width="42" Height="42" Background="#DDDDDD" Margin="0,0,12,0"><Border.OpacityMask><ImageBrush ImageSource="/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border.OpacityMask></Border>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="Nightwell" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="M U S I C" Style="{StaticResource Caption}" FontSize="9" Margin="1,2,0,0"/></StackPanel>
    </StackPanel>
   </Button>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Click="SearchClick" Height="40" MinHeight="0" Margin="0,0,8,0" Style="{StaticResource QuietButton}" ToolTip="Поиск музыки">
     <StackPanel Orientation="Horizontal"><Path Data="M 8,0 A 8,8 0 1 1 7.99,0 M 14,14 L 20,20" Stroke="#B4B4B4" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="Поиск" Foreground="{StaticResource SecondaryBrush}"/></StackPanel>
    </Button>
    <Button x:Name="NavigationMenu" Click="MenuClick" Style="{StaticResource IconButton}" ToolTip="Меню">
     <Grid Width="34" Height="34"><Ellipse Fill="#303030" Stroke="#555555"/><TextBlock x:Name="AvatarInitial" Text="♙" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="AvatarImage" Width="34" Height="34" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17"/></Image.Clip></Image></Grid>
    </Button>
   </StackPanel>
  </Grid>

  <Border x:Name="LibraryRail" Grid.Row="1" Margin="0,0,12,0" Visibility="Collapsed" CornerRadius="22" Background="#171717" BorderBrush="#303030" BorderThickness="1" Padding="14" ClipToBounds="True">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="Моя медиатека" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="×" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="CloseRailClick" ToolTip="Свернуть медиатеку"/></Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8"><Button Content="Избранное" Click="RailLikesClick" Style="{StaticResource QuietButton}" Padding="9,6"/><Button Content="Плейлисты" Click="RailPlaylistsClick" Style="{StaticResource QuietButton}" Padding="9,6"/></StackPanel>
    <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="RailBack" Content="Все плейлисты" Click="RailPlaylistsClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Visibility="Collapsed"/><Button x:Name="RailSort" Content="Сортировка" Click="RailSortClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/><Button Grid.Column="1" x:Name="RailActions" Content="⋯" Style="{StaticResource IconButton}" Click="RailActionsClick"/></Grid>
    <Grid Grid.Row="3"><ListBox x:Name="RailList" SelectionChanged="RailSelectionChanged" MouseDoubleClick="RailDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" Background="#292929" CornerRadius="7"><Grid><TextBlock Text="♫" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A5A5A5"/><Image Stretch="UniformToFill" local:Thumbnail.Track="{Binding Track}"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource SecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox><TextBlock x:Name="RailEmpty" Text="Здесь появится твоя музыка" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
   </Grid>
  </Border>
  <local:RoundedPanel Grid.Column="1" Grid.Row="1" CornerRadius="24" BorderThickness="1" BorderBrush="#313131" Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
   <Grid>
    <local:RibbonScene x:Name="Ribbon" IsHitTestVisible="False"/>
    <Grid x:Name="Home">

     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

     <Border x:Name="PlaybackBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24,28" Background="#801F1F1F" BorderBrush="#404040" BorderThickness="1" CornerRadius="14" Padding="12,8">
      <StackPanel Orientation="Horizontal"><Ellipse x:Name="PlaybackDot" Width="5" Height="5" Fill="#B6B6B6" Opacity="0.4" Margin="0,0,8,0"/><TextBlock x:Name="PlaybackBadgeText" Text="ТВОЙ ПОТОК" FontSize="9" Foreground="#BFBFBF" FontWeight="SemiBold"/></StackPanel>
     </Border>
     <Viewbox Grid.RowSpan="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="24,65,24,24"><StackPanel x:Name="HomeControls" HorizontalAlignment="Center">
      <StackPanel x:Name="HomeHeading" Margin="0,0,0,30">
       <TextBlock Text="ПЕРСОНАЛЬНАЯ ПОДБОРКА" TextAlignment="Center" Style="{StaticResource Caption}" FontSize="10"/>
       <TextBlock Text="Твой ритм" FontSize="42" FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,8"/>
       <TextBlock Text="Музыка, которая подходит тебе" Foreground="{StaticResource SecondaryBrush}" FontSize="13" TextAlignment="Center"/>
      </StackPanel>
      <Button x:Name="HomePlay" Content="&#xE768;" Width="88" Height="88" FontSize="30" Style="{StaticResource PlayButton}" Click="ToggleClick" ToolTip="Воспроизвести или поставить на паузу" HorizontalAlignment="Center"/>
      <Button Content="Новая подборка" Width="208" Height="44" Margin="0,22,0,0" Click="WaveClick" Style="{StaticResource PrimaryButton}"/>
      <Button Content="Настроить вкус" Width="208" Margin="0,6,0,0" Style="{StaticResource QuietButton}" Click="TasteClick"/>
      <Button x:Name="ContinuePhoneButton" Click="ContinuePhoneClick" Margin="0,24,0,0" Padding="18,13" Width="284" ToolTip="Продолжить слушать на компьютере">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="23" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Продолжить с телефона" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Твой трек и очередь, уже здесь" Foreground="{StaticResource SecondaryBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid>
      </Button>
     </StackPanel></Viewbox>
    </Grid>

    <Grid x:Name="Library" Visibility="Collapsed" Margin="24">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="LibraryEyebrow" Text="ТВОЯ МУЗЫКА" Style="{StaticResource Caption}"/><TextBlock x:Name="Heading" Text="Поиск" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" Text="{Binding Items.Count,ElementName=Tracks,Converter={StaticResource TrackCount}}"/></StackPanel>
      <Button x:Name="CollectionActions" Grid.Column="1" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}" Click="CollectionClick" VerticalAlignment="Bottom" ToolTip="Действия с коллекцией"/>
     </Grid>
     <StackPanel x:Name="SearchOptions" Grid.Row="1" Margin="0,0,0,16">
      <TextBox x:Name="SearchBox" Tag="Трек или исполнитель" TextChanged="SearchChanged" Height="46" ToolTip="Название трека или исполнитель" AutomationProperties.Name="Поиск музыки"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Исполнители" Click="SearchArtistsClick" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="Плейлисты" Click="SearchPlaylistsClick" Style="{StaticResource QuietButton}" Margin="0"/></StackPanel>
     </StackPanel>
     <Grid Grid.Row="2"><ListBox x:Name="Tracks" MouseDoubleClick="TrackDoubleClick" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate><DataTemplate><Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
       <Border Width="3" Height="18" Background="#B7B7B7" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-10,0,0,0">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource TrackMatch}"><Binding Path="id"/><Binding Path="MainWindow.PlayingTrackId" Source="{x:Static Application.Current}"/></MultiBinding></DataTrigger.Binding><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
       </Border>
       <Border Width="38" Height="38" CornerRadius="10" Background="#282828" BorderBrush="#3E3E3E" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True">
        <Grid><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#9C9C9C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         <Image Width="36" Height="36" Stretch="UniformToFill" local:Thumbnail.Track="{Binding}"/>
        </Grid>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
        <TextBlock Text="{Binding title}" FontSize="15" FontWeight="Medium"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource TrackMatch}"><Binding Path="id"/><Binding Path="MainWindow.PlayingTrackId" Source="{x:Static Application.Current}"/></MultiBinding></DataTrigger.Binding><Setter Property="Foreground" Value="#CACACA"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Text="{Binding SuggestionLabel}" FontSize="10" Foreground="#BEBEBE"/><TextBlock Text="{Binding artist}" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0"/>
       </StackPanel>
       <TextBlock Grid.Column="2" Text="{Binding DisplayDuration}" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <Button Grid.Column="3" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="TrackMenuClick" Style="{StaticResource IconButton}" ToolTip="Действия с треком"/>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems,ElementName=Tracks}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="#6B6B6B" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,16"/>
      <TextBlock x:Name="EmptyStateTitle" Text="Твоя музыка будет здесь" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
      <TextBlock x:Name="EmptyStateBody" Text="Выбери подборку или найди любимый трек" Foreground="{StaticResource SecondaryBrush}" FontSize="13" TextAlignment="Center" Margin="0,8,0,0"/>
     </StackPanel>
     </Grid>
    </Grid>

    <Grid x:Name="PlayerPage" Visibility="Collapsed" ClipToBounds="True" Background="#0D0D0F">
     <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <!-- Coloured background belongs only to the full player, not the monochrome library. -->
     <Grid Grid.RowSpan="2" ClipToBounds="True" IsHitTestVisible="False">
      <Image x:Name="PlayerAmbientA" Opacity="0" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin=".5,.5">
       <Image.RenderTransform><ScaleTransform ScaleX="1.16" ScaleY="1.16"/></Image.RenderTransform>
       <Image.Effect><BlurEffect Radius="50" RenderingBias="Performance"/></Image.Effect>
      </Image>
      <Image x:Name="PlayerAmbientB" Opacity="0" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin=".5,.5">
       <Image.RenderTransform><ScaleTransform ScaleX="1.16" ScaleY="1.16"/></Image.RenderTransform>
       <Image.Effect><BlurEffect Radius="50" RenderingBias="Performance"/></Image.Effect>
      </Image>
      <Border Background="#6807090D"/>
      <Border>
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8308090C" Offset="0"/><GradientStop Color="#1708090C" Offset=".45"/>
        <GradientStop Color="#A0090A0D" Offset="1"/>
       </LinearGradientBrush></Border.Background>
      </Border>
     </Grid>
     <Grid Margin="22,9,22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
      <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Click="ClosePlayerClick" Style="{StaticResource IconButton}" HorizontalAlignment="Left" ToolTip="Свернуть плеер"/>
      <TextBlock Grid.Column="1" Text="СЕЙЧАС ИГРАЕТ" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="FullLike" Content="♡" FontSize="22" Style="{StaticResource IconButton}" Click="LikeClick" ToolTip="В избранное"/><Button Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Click="CurrentMenuClick" Style="{StaticResource IconButton}" ToolTip="Меню плеера"/></StackPanel>
     </Grid>
     <Grid Grid.Row="1" Margin="24,1,24,12">
       <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="92"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid>
       <Viewbox MaxWidth="360" MaxHeight="340" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="360" Height="360" CornerRadius="22" Background="#262626" BorderBrush="#454545" BorderThickness="1">
         <Border.Clip><RectangleGeometry Rect="0,0,360,360" RadiusX="22" RadiusY="22"/></Border.Clip>
         <Grid><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="72" Foreground="#5A5A5A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image x:Name="Cover" Stretch="UniformToFill" Width="358" Height="358" MouseLeftButtonUp="CoverLyricsClick" Cursor="Hand" ToolTip="Открыть текст песни"/>
         </Grid>
        </Border>
       </Viewbox>
       <Border Background="#1A1A1A" CornerRadius="18" BorderBrush="#424242" BorderThickness="1" Visibility="{Binding Visibility,ElementName=LyricsPanel}">
        <ScrollViewer x:Name="LyricsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,44,0,0"><TextBlock x:Name="LyricsText" TextWrapping="Wrap" FontSize="19" Margin="24,8,24,24" LineHeight="32" TextAlignment="Left"/></ScrollViewer>
       </Border>
       <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Click="CloseLyricsClick" Visibility="{Binding Visibility,ElementName=LyricsPanel}" ToolTip="Вернуться к обложке"/>
      </Grid>
      <Border Grid.Row="1" Background="#A8141519" BorderBrush="#48FFFFFF" BorderThickness="1"
                CornerRadius="24" HorizontalAlignment="Center" Padding="17,11,17,11">
        <Viewbox MaxWidth="495" Stretch="Uniform" StretchDirection="DownOnly">
         <StackPanel Width="450">
       <TextBlock x:Name="FullTitle" Text="Выбери трек" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" MaxHeight="65"/>
       <TextBlock x:Name="FullArtist" MouseLeftButtonUp="FullArtistClick" Cursor="Hand" FontSize="14" Foreground="#D0D0D0" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,9" ToolTip="Открыть исполнителя"/>
       <Slider x:Name="FullSeek" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="SeekStart" PreviewMouseLeftButtonUp="SeekEnd" AutomationProperties.Name="Позиция воспроизведения"/>
       <TextBlock x:Name="FullTime" Text="0:00    /    0:00" FontSize="12" Foreground="#D0D0D0" HorizontalAlignment="Center" Margin="0,3,0,8"/>
       <Grid HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="48"/><ColumnDefinition Width="80"/><ColumnDefinition Width="48"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
        <Button x:Name="ShuffleButton" Content="&#xE8B1;" Style="{StaticResource TransportButton}" Click="ShuffleClick" ToolTip="Перемешать" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="&#xE892;" Style="{StaticResource TransportButton}" Click="PreviousClick" ToolTip="Предыдущий трек" VerticalAlignment="Center"/>
        <Button Grid.Column="2" x:Name="FullPlay" Content="&#xE768;" Style="{StaticResource PlayButton}" Click="ToggleClick" ToolTip="Воспроизвести или поставить на паузу"/>
        <Button Grid.Column="3" Content="&#xE893;" Style="{StaticResource TransportButton}" Click="NextClick" ToolTip="Следующий трек" VerticalAlignment="Center"/>
        <Grid Grid.Column="4" VerticalAlignment="Center"><Button x:Name="RepeatButton" Content="&#xE8EE;" Style="{StaticResource TransportButton}" Click="RepeatClick" ToolTip="Повтор"/><TextBlock x:Name="RepeatOne" Text="1" Foreground="#CACACA" FontSize="9" Margin="0,3,5,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/></Grid>
       </Grid>
       <Grid Margin="55,8,55,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="15"/>
        <Slider Grid.Column="1" x:Name="FullVolumeSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeChanged" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0" AutomationProperties.Name="Громкость"/>
        <TextBlock Grid.Column="2" x:Name="FullVolumeValue" Text="100%" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
       </Grid>
       <Button Content="Очередь воспроизведения" Click="QueueClick" Style="{StaticResource QuietButton}" FontSize="12" Margin="0,7,0,0"/>
      </StackPanel></Viewbox></Border>
      </Grid>
     </Grid>
    <Grid x:Name="SheetHost" Visibility="Collapsed" Background="#171717"/>
    </Grid>
   </local:RoundedPanel>

  <TextBlock x:Name="Status" Grid.ColumnSpan="2" Grid.Row="2" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="44" Margin="4,10,4,8">
   <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  <Border x:Name="Dock" Grid.ColumnSpan="2" Grid.Row="3" Height="76" Margin="0,14,0,0" Background="#1C1C1C" BorderBrush="#383838" BorderThickness="1" CornerRadius="18" Padding="16,10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="164"/></Grid.ColumnDefinitions>
    <Grid MouseLeftButtonUp="OpenPlayerClick" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,16,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Width="44" Height="44" CornerRadius="11" Background="#2F2F2F" BorderBrush="#464646" BorderThickness="1" HorizontalAlignment="Left">
      <Grid><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="#A0A0A0" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Image x:Name="MiniCover" Width="42" Height="42" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,42,42" RadiusX="10" RadiusY="10"/></Image.Clip></Image>
      </Grid>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock x:Name="MiniTitle" Text="Выбери трек" FontSize="14" FontWeight="SemiBold"/>
      <TextBlock x:Name="MiniArtist" Text="И начни слушать" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="MiniLike" Content="♡" Style="{StaticResource IconButton}" FontSize="22" Margin="0,0,8,0" Click="LikeClick" ToolTip="В избранное"/>
     <Button Content="&#xE892;" Click="PreviousClick" Style="{StaticResource TransportButton}" ToolTip="Предыдущий трек"/>
     <Button x:Name="MiniPlay" Content="&#xE768;" Width="46" Height="46" FontSize="18" Margin="8,0" Style="{StaticResource PlayButton}" Click="ToggleClick" ToolTip="Воспроизвести или поставить на паузу"/>
     <Button Content="&#xE893;" Click="NextClick" Style="{StaticResource TransportButton}" ToolTip="Следующий трек"/>
    </StackPanel>
    <Grid Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
     <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
     <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeChanged" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0" AutomationProperties.Name="Громкость миниплеера"/>
     <TextBlock x:Name="MiniVolumeValue" Grid.Column="2" Text="100%" FontSize="11" Foreground="{StaticResource SecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <Border x:Name="MiniProgress" Background="#939393" HorizontalAlignment="Left" Width="0" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-9" Grid.ColumnSpan="3" IsHitTestVisible="False" CornerRadius="1"/>
   </Grid>
  </Border>
  <Canvas x:Name="MenuLayer" Grid.RowSpan="4" Grid.ColumnSpan="2" Visibility="Collapsed" ClipToBounds="True" Panel.ZIndex="100"/>
 </Grid>
</Window>
