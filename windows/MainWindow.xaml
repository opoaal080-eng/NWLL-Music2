<Window x:Class="Nightwell.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nightwell.Native"
 Title="Nightwell Music" Width="1120" Height="800" MinWidth="800" MinHeight="620" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
 <Grid Background="{StaticResource WindowBrush}" Margin="24,18,24,20">
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Header" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Width="40" Height="40" CornerRadius="12" Background="#182434" BorderBrush="#35475F" BorderThickness="1" Margin="0,0,12,0">
     <Path Data="M 0,17 L 0,0 L 12,17 L 12,0 M 17,0 L 21,17 L 26,7 L 31,17 L 35,0" Stroke="#ACBDD7" StrokeThickness="1.8" Width="28" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="Nightwell" FontSize="21" FontWeight="SemiBold"/>
     <TextBlock Text="M U S I C" Style="{StaticResource Caption}" FontSize="9" Margin="1,2,0,0"/>
    </StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Click="SearchClick" Height="40" MinHeight="0" Margin="0,0,8,0" Style="{StaticResource QuietButton}" ToolTip="Поиск музыки">
     <StackPanel Orientation="Horizontal"><Path Data="M 8,0 A 8,8 0 1 1 7.99,0 M 14,14 L 20,20" Stroke="#A8B5C8" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" Margin="0,0,9,0"/><TextBlock Text="Поиск" Foreground="{StaticResource SecondaryBrush}"/></StackPanel>
    </Button>
    <Button x:Name="NavigationMenu" Click="MenuClick" Style="{StaticResource IconButton}" ToolTip="Меню">
     <Path Data="M 0,0 H 18 M 0,6 H 18 M 0,12 H 18" Stroke="#B2C0D3" StrokeThickness="1.6" Width="18" Height="12" Stretch="Uniform"/>
    </Button>
   </StackPanel>
  </Grid>

  <local:RoundedPanel Grid.Row="1" CornerRadius="24" BorderThickness="1" BorderBrush="#253245" Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
   <Grid>
    <Grid x:Name="Home">
     <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#131D2A" Offset="0"/><GradientStop Color="#10161F" Offset="0.5"/><GradientStop Color="#0D131C" Offset="1"/></LinearGradientBrush></Grid.Background>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <local:RibbonScene x:Name="Ribbon" Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.75"/>
     <StackPanel x:Name="HomeHeading" Margin="32,28,32,0">
      <TextBlock Text="ПЕРСОНАЛЬНАЯ ПОДБОРКА" Style="{StaticResource Caption}" Foreground="#9AADC9" FontSize="10"/>
      <TextBlock Text="Твой ритм" FontSize="42" FontWeight="SemiBold" Margin="-2,8,0,0"/>
      <TextBlock Text="Музыка, которая подходит тебе." Foreground="{StaticResource SecondaryBrush}" FontSize="14" Margin="0,8,0,0"/>
     </StackPanel>
     <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,12,0,24"><StackPanel x:Name="HomeControls" VerticalAlignment="Center" HorizontalAlignment="Center">
      <Button x:Name="HomePlay" Content="&#xE768;" Width="88" Height="88" FontSize="30" Style="{StaticResource PlayButton}" Click="ToggleClick" ToolTip="Воспроизвести или поставить на паузу" AutomationProperties.Name="Воспроизведение подборки"/>
      <Button Content="Новая подборка" Width="200" Height="44" Margin="0,22,0,0" Click="WaveClick" Style="{StaticResource PrimaryButton}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
       <Button Content="Настроить" Width="112" Style="{StaticResource QuietButton}" Click="TasteClick"/>
       <Border Width="1" Height="16" Background="#2D3C50" VerticalAlignment="Center" Margin="8,0"/>
       <Button Content="Только фон" Width="112" Style="{StaticResource QuietButton}" Click="BackgroundClick"/>
      </StackPanel>
     </StackPanel></Viewbox>
    </Grid>

    <Grid x:Name="Library" Visibility="Collapsed" Margin="24">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="ТВОЯ МУЗЫКА" Style="{StaticResource Caption}"/><TextBlock x:Name="Heading" Text="Поиск" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
      <Button x:Name="CollectionActions" Grid.Column="1" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}" Click="CollectionClick" VerticalAlignment="Bottom" ToolTip="Действия с коллекцией"/>
     </Grid>
     <StackPanel x:Name="SearchOptions" Grid.Row="1" Margin="0,0,0,16">
      <TextBox x:Name="SearchBox" TextChanged="SearchChanged" Height="46" ToolTip="Название трека или исполнитель" AutomationProperties.Name="Поиск музыки"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Исполнители" Click="SearchArtistsClick" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/><Button Content="Плейлисты" Click="SearchPlaylistsClick" Style="{StaticResource QuietButton}" Margin="0"/></StackPanel>
     </StackPanel>
     <ListBox x:Name="Tracks" Grid.Row="2" MouseDoubleClick="TrackDoubleClick" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate><DataTemplate><Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
       <Border Width="38" Height="38" CornerRadius="10" Background="#1D2939" BorderBrush="#304057" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#889EBE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
        <TextBlock Text="{Binding title}" FontSize="15" FontWeight="Medium"/>
        <TextBlock Text="{Binding artist}" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0"/>
       </StackPanel>
       <Button Grid.Column="2" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="TrackMenuClick" Style="{StaticResource IconButton}" ToolTip="Действия с треком"/>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>

    <Grid x:Name="PlayerPage" Visibility="Collapsed" Margin="24">
     <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
      <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Click="ClosePlayerClick" Style="{StaticResource IconButton}" ToolTip="Свернуть плеер"/>
      <TextBlock Grid.Column="1" Text="СЕЙЧАС ИГРАЕТ" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Button Grid.Column="2" Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Click="CurrentMenuClick" Style="{StaticResource IconButton}" ToolTip="Меню плеера"/>
     </Grid>
     <Grid Grid.Row="1" Margin="8,24,8,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid>
       <Viewbox MaxWidth="360" MaxHeight="360" Stretch="Uniform" StretchDirection="DownOnly">
        <Border Width="360" Height="360" CornerRadius="22" Background="#1B2738" BorderBrush="#35475F" BorderThickness="1">
         <Border.Clip><RectangleGeometry Rect="0,0,360,360" RadiusX="22" RadiusY="22"/></Border.Clip>
         <Grid><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="72" Foreground="#465C7B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image x:Name="Cover" Stretch="UniformToFill" Width="358" Height="358" MouseLeftButtonUp="CoverLyricsClick" Cursor="Hand" ToolTip="Открыть текст песни"/>
         </Grid>
        </Border>
       </Viewbox>
       <Border Background="#121B27" CornerRadius="18" BorderBrush="#33445D" BorderThickness="1" Visibility="{Binding Visibility,ElementName=LyricsPanel}">
        <ScrollViewer x:Name="LyricsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,44,0,0"><TextBlock x:Name="LyricsText" TextWrapping="Wrap" FontSize="19" Margin="24,8,24,24" LineHeight="32" TextAlignment="Left"/></ScrollViewer>
       </Border>
       <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Click="CloseLyricsClick" Visibility="{Binding Visibility,ElementName=LyricsPanel}" ToolTip="Вернуться к обложке"/>
      </Grid>
      <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center"><StackPanel Width="420">
       <TextBlock Text="ТВОЙ МУЗЫКАЛЬНЫЙ МОМЕНТ" Style="{StaticResource Caption}" FontSize="10" Margin="0,0,0,14"/>
       <TextBlock x:Name="FullTitle" Text="Выбери трек" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="78"/>
       <TextBlock x:Name="FullArtist" MouseLeftButtonUp="FullArtistClick" Cursor="Hand" FontSize="15" Foreground="{StaticResource SecondaryBrush}" Margin="0,10,0,22" ToolTip="Открыть исполнителя"/>
       <Slider x:Name="FullSeek" Minimum="0" Maximum="1" PreviewMouseLeftButtonDown="SeekStart" PreviewMouseLeftButtonUp="SeekEnd" AutomationProperties.Name="Позиция воспроизведения"/>
       <TextBlock x:Name="FullTime" Text="0:00    /    0:00" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,18"/>
       <Grid HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="48"/><ColumnDefinition Width="80"/><ColumnDefinition Width="48"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
        <Button Content="&#xE8B1;" Style="{StaticResource TransportButton}" Click="ShuffleClick" ToolTip="Перемешать" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="&#xE892;" Style="{StaticResource TransportButton}" Click="PreviousClick" ToolTip="Предыдущий трек" VerticalAlignment="Center"/>
        <Button Grid.Column="2" x:Name="FullPlay" Content="&#xE768;" Style="{StaticResource PlayButton}" Click="ToggleClick" ToolTip="Воспроизвести или поставить на паузу"/>
        <Button Grid.Column="3" Content="&#xE893;" Style="{StaticResource TransportButton}" Click="NextClick" ToolTip="Следующий трек" VerticalAlignment="Center"/>
        <Button Grid.Column="4" Content="&#xE8EE;" Style="{StaticResource TransportButton}" Click="RepeatClick" ToolTip="Повтор" VerticalAlignment="Center"/>
       </Grid>
       <Grid Margin="16,24,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="15"/>
        <Slider Grid.Column="1" x:Name="FullVolumeSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeChanged" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0" AutomationProperties.Name="Громкость"/>
        <TextBlock Grid.Column="2" x:Name="FullVolumeValue" Text="100%" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
       </Grid>
       <Button Content="Очередь воспроизведения" Click="QueueClick" Style="{StaticResource QuietButton}" FontSize="13" Margin="0,14,0,0"/>
      </StackPanel></Viewbox>
     </Grid>
    </Grid>
   </Grid>
  </local:RoundedPanel>

  <TextBlock x:Name="Status" Grid.Row="2" Foreground="{StaticResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="44" Margin="4,10,4,8">
   <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
  <Border x:Name="Dock" Grid.Row="3" Height="76" Margin="0,14,0,0" Background="#131D29" BorderBrush="#2B3A50" BorderThickness="1" CornerRadius="18" Padding="16,10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="164"/></Grid.ColumnDefinitions>
    <Grid MouseLeftButtonUp="OpenPlayerClick" Cursor="Hand" VerticalAlignment="Center" Margin="0,0,16,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Width="44" Height="44" CornerRadius="11" Background="#213149" BorderBrush="#344863" BorderThickness="1" HorizontalAlignment="Left">
      <Grid><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="#8CA2C5" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Image x:Name="MiniCover" Width="42" Height="42" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,42,42" RadiusX="10" RadiusY="10"/></Image.Clip></Image>
      </Grid>
     </Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock x:Name="MiniTitle" Text="Выбери трек" FontSize="14" FontWeight="SemiBold"/>
      <TextBlock x:Name="MiniArtist" Text="И начни слушать" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,5,0,0"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="MiniLike" Content="♡" Style="{StaticResource IconButton}" FontSize="22" Margin="0,0,8,0" Click="LikeClick" ToolTip="В избранное"/>
     <Button Content="&#xE892;" Click="PreviousClick" Style="{StaticResource TransportButton}" ToolTip="Предыдущий трек"/>
     <Button x:Name="MiniPlay" Content="&#xE768;" Width="46" Height="46" FontSize="18" Margin="8,0" Style="{StaticResource PlayButton}" Click="ToggleClick" ToolTip="Воспроизвести или поставить на паузу"/>
     <Button Content="&#xE893;" Click="NextClick" Style="{StaticResource TransportButton}" ToolTip="Следующий трек"/>
    </StackPanel>
    <Grid Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
     <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
     <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeChanged" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="0" AutomationProperties.Name="Громкость миниплеера"/>
     <TextBlock x:Name="MiniVolumeValue" Grid.Column="2" Text="100%" FontSize="11" Foreground="{StaticResource SecondaryBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <Border x:Name="MiniProgress" Background="#7A96BD" HorizontalAlignment="Left" Width="0" Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-9" Grid.ColumnSpan="3" IsHitTestVisible="False" CornerRadius="1"/>
   </Grid>
  </Border>
 </Grid>
</Window>
